FROM nginx:stable-alpine

RUN rm /etc/nginx/conf.d/default.conf \
    && sed -i '1i load_module modules/ngx_http_js_module.so;' /etc/nginx/nginx.conf
COPY mainnet.conf /etc/nginx/templates/default.conf.template
COPY 05-host.sh /docker-entrypoint.d/05-host.sh
# nginx sources executable .envsh hooks so exports reach its envsubst hook.
# Keep the requested .sh hook and also install it as a sourced environment hook.
RUN chmod +x /docker-entrypoint.d/05-host.sh \
    && cp /docker-entrypoint.d/05-host.sh /docker-entrypoint.d/05-host.envsh
# The tunnel gate (native spec 2026-10-01-play-internal-test §3.2): njs method allowlist + app key.
COPY rpc_allow.js /etc/nginx/njs/rpc_allow.js
COPY rpc_body.conf /etc/nginx/rpc_body.conf
COPY 04-require-key.sh /docker-entrypoint.d/04-require-key.sh
RUN chmod +x /docker-entrypoint.d/04-require-key.sh
