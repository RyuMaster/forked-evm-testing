# Taurion PRODUCTION stack (real Polygon mainnet). Every value below is also the compose default,
# so this file is optional -- copy it to .env only to override something.

# Polygon mainnet JSON-RPC, used by xayax and by the phone through nginx /chain.
BLOCKCHAIN_ENDPOINT="https://polygon-node.xaya.io"

# Optional X-goog-api-key header for that node (added by nginx only).
BLOCKCHAIN_API_KEY=""

# Optional WebSocket URL for new-block pushes; xayax polls through nginx when unset.
BLOCKCHAIN_WS_ENDPOINT=""

# The official XayaAccounts contract on Polygon mainnet (shared by all Xaya games, Taurion is g/tn).
ACCOUNTS_CONTRACT="0x8C12253F71091b9582908C8a44F78870Ec6F304F"

# The locally-loaded Taurion GSP image on the laptop (the same one the anvil stack runs).
GSP_IMAGE="tn-base:latest"

# Host port for /gsp and /chain. 8101 is the anvil stack, 8103 the map host.
TAURION_PRODUCTION_PORT=8102
