# Polygon mainnet JSON-RPC (full node is enough: xayax reads logs, not state).
BLOCKCHAIN_ENDPOINT="https://polygon-node.xaya.io"
# Optional WebSocket URL for new-block pushes; xayax polls when it is empty or refused.
BLOCKCHAIN_WS_ENDPOINT=""
# Optional header the node wants (X-goog-api-key). Stays on this machine; the phone never sees it.
BLOCKCHAIN_API_KEY=""
ACCOUNTS_CONTRACT="0x8C12253F71091b9582908C8a44F78870Ec6F304F"
GSP_IMAGE="tn-base:latest"
TAURION_MAINNET_PORT=8102
